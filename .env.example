# Holy Corner - every environment variable the app reads, named here.
#
# THE RULE: if the code reads a variable, it is listed in this file. No exceptions.
#
# This is not bookkeeping. Fountainbridge FB-087 is the reason: a variable the code read and no
# file mentioned is how a surface stayed broken for weeks, with nobody able to see that the thing
# it needed had never been set. HC-007 adds `scripts/env-check.mjs`, which diffs this file against
# the variables the code actually reads and fails CI on a gap.
#
# THIS FILE HOLDS NAMES AND HARMLESS EXAMPLES, NEVER VALUES. Real values live in the Railway
# environment (CLAUDE.md #9). Bank details live in Wise. Nothing secret is committed, ever - not
# here, not in a ticket, not in a fixture, not in a screenshot, not in gbrain.
#
# Each ticket adds the variables it introduces, so this file grows with the code rather than ahead
# of it. Still to come:
#
#   HC-013  ANTHROPIC_API_KEY, HC_MODEL_FOREGROUND, HC_MODEL_BACKGROUND
#   HC-015  WISE_* (read-only; the route is decided by ADR-0003, after SD3-0108)
#   HC-031  GM_SERVICE_TOKEN
#   HC-032  FB_GITHUB_TOKEN
#   HC-042  HC_APPROVAL_SECRET
#
# That list is a map of what is coming, not a licence to add them early.


# ============================================================================================
# Sign-in (HC-003)
# ============================================================================================

# Signs the session cookie. Generate one with `openssl rand -base64 32`. HC-004 refuses to boot in
# production on a placeholder or on anything under 32 characters, because a short secret on the
# thing that says who you are is not a smaller problem than no secret.
AUTH_SECRET=

# Railway is not Vercel, so Auth.js has to be told the host is trustworthy. Without it sign-in
# returns a 500 that does not say why.
AUTH_TRUST_HOST=true

# The Google client for os.bruntsfieldcapital.com. HC-007 creates the production one and sets the
# callback URL; these stay empty in the repository, always.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who is an administrator, comma or space separated. BOTH of John's addresses belong here: one is
# on the Workspace domain and one is not, and the second is the reason the domain check below has
# an explicit exemption for allowlisted admins.
HC_ADMIN_EMAILS=john@bruntsfield.capital,john.gallagher@wealthcx.com

# The Google Workspace domain. An identity outside it is REFUSED, not merely left without a role,
# unless it is on the admin allowlist above. Never a personal @gmail.com (CLAUDE.md #8).
HC_WORKSPACE_DOMAIN=bruntsfield.capital

# The second door: `email=scrypt:...` entries, comma or space separated. Unset, the password form
# does not render and the provider does not exist.
#
# MINT ENTRIES, NEVER TYPE THEM: `node scripts/mint-password-login.mjs <email>` reads the password
# from stdin, so it never reaches your shell history. A plaintext password pasted here is skipped
# with a warning that names its position and never its content.
HC_PASSWORD_LOGINS=

# The end-to-end test door. BOTH must be set for it to exist, so a stray E2E_TEST_LOGIN=1 in
# production is inert. Never set on a real deployment. HC-006's UI gate uses it to drive the four
# roles without a live Google client.
E2E_TEST_LOGIN=
E2E_TEST_LOGIN_SECRET=

# Role assignments, TEMPORARY, and not a production variable.
#
# `email=role[:pillar|pillar]`, comma or space separated. It exists only so the four roles can be
# exercised before there is a database. HC-004 creates the `role_assignments` table and DELETES
# this variable; `lib/session.ts` is the one file that changes, because everything downstream takes
# a RoleSource rather than reading the environment.
HC_ROLE_ASSIGNMENTS=


# ============================================================================================
# The record (HC-004)
# ============================================================================================

# Postgres. Railway injects this when the add-on is attached; HC-001 attached it already.
#
# Production REFUSES TO BOOT without it, and refuses anything that looks like SQLite. That is not
# a preference: this runs one long-running server with background jobs reading Wise, so two
# writers is the normal case, and one file is Elite Vault's specific mistake (plan D3).
#
# Migrations run at boot as well as on `npm run db:migrate`, so a deploy cannot reach a schema it
# was not built for. Unset locally, the tests still run: they use PGLite, an in-memory Postgres.
DATABASE_URL=
